{
  "name": "tessel",
  "productName": "Tessel",
  "version": "1.5.0",
  "description": "Desktop app for creating mosaic videos",
  "main": "main.js",
  "scripts": {
    "prepare": "git config core.hooksPath scripts/githooks || true",
    "start": "electron .",
    "dev": " nodemon --exec electron .",
    "package-mac": "node scripts/package.mjs darwin",
    "package-win": "node scripts/package.mjs win32",
    "package-linux": "node scripts/package.mjs linux",
    "test": "node --test test/*.test.js"
  },
  "author": "James Sorbello",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.0.4",
    "electron": "^44.0.0",
    "nodemon": "^3.1.14"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
