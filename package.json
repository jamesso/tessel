{
  "name": "tessel",
  "productName": "Tessel",
  "version": "1.4.0",
  "description": "Desktop app for creating mosaic videos",
  "main": "main.js",
  "scripts": {
    "prepare": "git config core.hooksPath scripts/githooks || true",
    "start": "electron .",
    "dev": " nodemon --exec electron .",
    "package-mac": "npx @electron/packager . --overwrite --asar.unpackDir=node_modules/ffmpeg-static --platform=darwin --arch=arm64 --icon=assets/icons/mac/icon.icns --prune=true --out=release-builds",
    "package-win": "npx @electron/packager . --overwrite --asar.unpackDir=node_modules/ffmpeg-static --platform=win32 --arch=x64 --icon=assets/icons/win/icon.ico --prune=true --out=release-builds --win32metadata.CompanyName=Tessel --win32metadata.FileDescription=Tessel --win32metadata.ProductName=\"Tessel\"",
    "package-linux": "npx @electron/packager . --overwrite --asar.unpackDir=node_modules/ffmpeg-static --platform=linux --arch=x64 --icon=assets/icons/linux/icon.png --prune=true --out=release-builds",
    "test": "node --test test/"
  },
  "author": "James Sorbello",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.4",
    "electron": "^44.0.0",
    "nodemon": "^3.1.14"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
