#!/bin/sh
# Strip AI co-author / "Generated with" trailers from every commit (tool-agnostic).
# npm install runs prepare, which sets core.hooksPath to scripts/githooks (local to
# the repo). Requires python3 on PATH. Do not copy this file into .git/hooks.
set -e
msgfile="$1"
if [ ! -f "$msgfile" ]; then
  exit 0
fi
python3 - "$msgfile" <<'PY'
import re
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as f:
    original = f.read()

ai_trailer = re.compile(
    r"^\s*(Claude-Session|Made-with)\s*:.*$|^\s*(🤖\s*)?Generated with\b.*$",
    re.IGNORECASE,
)
ai_coauthor = re.compile(
    r"^\s*(Co-authored-by|Co-Authored-By)\s*:.*("
    r"Cursor|Claude|Codex|Copilot|ChatGPT|Gemini|OpenAI|Anthropic|"
    r"cursoragent@cursor\.com|noreply@anthropic\.com|copilot@|openai\.com"
    r").*$",
    re.IGNORECASE,
)

kept = []
for line in original.splitlines():
    if ai_trailer.match(line) or ai_coauthor.match(line):
        continue
    kept.append(line)

while kept and not kept[-1].strip():
    kept.pop()

text = "\n".join(kept)
if text:
    text += "\n"

if text != original:
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)
PY
